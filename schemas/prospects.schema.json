{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mtg-analyzer:prospects:1",
  "title": "Osservazioni e scenari editoriali per carta",
  "$defs": {
    "formatAssessment": {
      "type": "object",
      "required": [
        "legality",
        "evidence",
        "prospect",
        "confidence"
      ],
      "properties": {
        "legality": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "prospect": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "bassa",
            "media",
            "alta"
          ]
        },
        "observation": {
          "type": "integer",
          "minimum": 0
        },
        "tournamentIndex": {
          "$ref": "#/$defs/tournamentIndex"
        }
      },
      "additionalProperties": true
    },
    "nullablePrice": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cardProspects": {
      "type": "object",
      "required": [
        "date",
        "kind",
        "summary",
        "gameplayReview",
        "sources",
        "oracle",
        "formats",
        "tournamentObservations",
        "commanderObservations",
        "price",
        "limitations"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "const": "evidence_and_editorial_scenarios"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "gameplayReview": {
          "type": "object",
          "required": [
            "kind",
            "finding",
            "evidenceOfTournamentSuccess"
          ],
          "properties": {
            "kind": {
              "const": "analisi_editoriale_oracle"
            },
            "finding": {
              "type": "string",
              "minLength": 1
            },
            "evidenceOfTournamentSuccess": {
              "const": false
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "oracle": {
          "type": "object",
          "required": [
            "printingId",
            "url",
            "set",
            "number",
            "text"
          ]
        },
        "formats": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/formatAssessment"
          }
        },
        "tournamentObservations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "format",
              "decklistsWithCard",
              "source"
            ]
          }
        },
        "commanderObservations": {
          "type": "array"
        },
        "price": {
          "type": "object",
          "required": [
            "date",
            "currency",
            "metric",
            "printingId",
            "nonfoil",
            "foil",
            "comparison",
            "variants",
            "outlook"
          ],
          "properties": {
            "currency": {
              "const": "EUR"
            },
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "from": {
              "$ref": "#/$defs/nullablePrice"
            },
            "finishFilter": {
              "enum": [
                "any",
                "nonfoil",
                "foil"
              ]
            },
            "nonfoil": {
              "$ref": "#/$defs/nullablePrice"
            },
            "foil": {
              "$ref": "#/$defs/nullablePrice"
            },
            "comparison": {
              "type": "object",
              "required": [
                "date",
                "samePrinting",
                "nonfoil",
                "changePct",
                "status"
              ],
              "properties": {
                "samePrinting": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "from": {
                  "$ref": "#/$defs/nullablePrice"
                },
                "nonfoil": {
                  "$ref": "#/$defs/nullablePrice"
                },
                "changePct": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "comparable",
                    "missing_reference"
                  ]
                }
              }
            },
            "outlook": {
              "type": "object",
              "required": [
                "kind",
                "thesis",
                "confidence",
                "targetPrice",
                "probabilityOfRise"
              ],
              "properties": {
                "kind": {
                  "const": "scenario_condizionale"
                },
                "thesis": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "const": "bassa"
                },
                "targetPrice": {
                  "type": "null"
                },
                "probabilityOfRise": {
                  "type": "null"
                }
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decisionReview": {
          "type": "object",
          "required": [
            "date",
            "kind",
            "context",
            "verdict",
            "sections"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "kind": {
              "type": "string"
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "type": "string",
              "minLength": 1
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "text"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "additionalProperties": true
        },
        "limitedAnalysis": {
          "type": "object",
          "required": [
            "date",
            "kind",
            "draft",
            "sealed",
            "partners",
            "observedWinRates"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "kind": {
              "enum": [
                "qualitative_editorial_prerelease",
                "qualitative_editorial"
              ]
            },
            "draft": {
              "$ref": "#/$defs/limitedAssessment"
            },
            "sealed": {
              "$ref": "#/$defs/limitedAssessment"
            },
            "partners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observedWinRates": {
              "const": false
            },
            "usage": {
              "type": "object",
              "required": [
                "role",
                "plan",
                "conditions",
                "confidence"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "plan": {
                  "type": "string",
                  "minLength": 1
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "enum": [
                    "bassa",
                    "media",
                    "alta"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "limitedImpact": {
          "type": "object",
          "required": [
            "date",
            "kind",
            "label",
            "why",
            "draft",
            "sealed",
            "before",
            "after",
            "limit"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "kind": {
              "const": "editorial_game_changer"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "type": "string",
              "minLength": 1
            },
            "draft": {
              "type": "string",
              "minLength": 1
            },
            "sealed": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "after": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "limitedApplicability": {
          "type": "object",
          "required": [
            "date",
            "status",
            "note"
          ],
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "tournamentIndex": {
      "type": "object",
      "required": [
        "schemaVersion",
        "method",
        "date",
        "score",
        "reason",
        "status",
        "sample",
        "observed",
        "trend",
        "outlook",
        "history",
        "examples"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "method": {
          "const": "published-deck-share-v1"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reason": {
          "enum": [
            null,
            "not_legal",
            "legality_unknown",
            "basic_land",
            "no_post_release_sample"
          ]
        },
        "status": {
          "enum": [
            "unavailable",
            "not_observed",
            "repeated",
            "first_sightings"
          ]
        },
        "sample": {
          "type": "object",
          "required": [
            "start",
            "end",
            "decks",
            "events"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "decks": {
              "type": "integer",
              "minimum": 0
            },
            "events": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "observed": {
          "type": "object",
          "required": [
            "withCard",
            "mainDecks",
            "sideboardDecks",
            "mainCopies",
            "sideboardCopies",
            "eventsWithCard",
            "top8Lists",
            "winningLists"
          ],
          "properties": {
            "withCard": {
              "type": "integer",
              "minimum": 0
            },
            "mainDecks": {
              "type": "integer",
              "minimum": 0
            },
            "sideboardDecks": {
              "type": "integer",
              "minimum": 0
            },
            "mainCopies": {
              "type": "integer",
              "minimum": 0
            },
            "sideboardCopies": {
              "type": "integer",
              "minimum": 0
            },
            "eventsWithCard": {
              "type": "integer",
              "minimum": 0
            },
            "top8Lists": {
              "type": "integer",
              "minimum": 0
            },
            "winningLists": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "examples": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "event",
              "eventId",
              "date",
              "player",
              "url",
              "main",
              "sideboard"
            ]
          }
        },
        "outlook": {
          "type": "object",
          "required": [
            "status",
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "observational_signal_not_forecast"
            },
            "status": {
              "enum": [
                "not_assessed",
                "watch",
                "repeated_use",
                "no_signal"
              ]
            }
          }
        }
      },
      "additionalProperties": true
    },
    "limitedAssessment": {
      "type": "object",
      "required": [
        "tier",
        "note"
      ],
      "properties": {
        "tier": {
          "enum": [
            "P",
            "S",
            "Y",
            "F",
            "B",
            "N"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "$ref": "#/$defs/cardProspects"
}
