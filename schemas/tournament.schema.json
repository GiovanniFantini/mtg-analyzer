{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mtg-analyzer:local-tournament:1",
  "title": "Torneo locale indipendente dall'espansione, versione 1",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "name", "set", "status", "roundLimit", "roundMinutes", "players", "rounds", "timer"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "mtg-local-tournament"},
    "id": {"type": "string", "maxLength": 100},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "set": {"type": "string", "maxLength": 160},
    "status": {"enum": ["registration", "active", "complete"]},
    "endedEarly": {"type": "boolean", "description": "Chiusura esplicita prima dei turni annunciati quando restano meno di due giocatori attivi."},
    "roundLimit": {"type": "integer", "minimum": 1, "maximum": 7},
    "roundMinutes": {"type": "integer", "minimum": 1, "maximum": 180},
    "players": {"type": "array", "maxItems": 8, "items": {
      "type": "object", "required": ["id", "name", "dropped"], "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "dropped": {"type": "boolean"}
      }
    }},
    "rounds": {"type": "array", "maxItems": 7, "items": {
      "type": "object", "required": ["number", "matches"], "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 7},
        "rematch": {"type": "boolean"},
        "matches": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
          "type": "object", "required": ["a", "b", "result"], "properties": {
            "a": {"type": "string"}, "b": {"type": ["string", "null"]},
            "result": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 3, "maxItems": 3,
              "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 2}, {"type": "integer", "minimum": 0, "maximum": 2}, {"type": "integer", "minimum": 0, "maximum": 20}]}]}
          }
        }}
      }
    }},
    "timer": {"type": "object", "required": ["remainingMs", "deadline", "label"], "properties": {
      "remainingMs": {"type": "integer", "minimum": 0, "maximum": 10800000},
      "deadline": {"type": ["number", "null"], "minimum": 0},
      "label": {"type": "string", "maxLength": 80}
    }}
  },
  "$comment": "Vincoli referenziali, nomi distinti, ordine turni, bye 2-0 e risultati completi dei turni precedenti sono verificati da tournament-engine.js."
}
