{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mtg-analyzer:limited:1",
  "title": "MTG Analyzer event rules v1",
  "type": "object", "required": ["schemaVersion", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "events": {"type": "object", "additionalProperties": {
      "type": "object",
      "required": ["id", "name", "kind", "product", "packsPerPlayer", "seats", "picksPerTurn", "directions", "minDeckSize", "mulligan", "sources"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "kind": {"enum": ["draft", "sealed"]},
        "product": {"type": "string"}, "packsPerPlayer": {"type": "integer", "minimum": 1},
        "seats": {"type": "integer", "minimum": 1}, "picksPerTurn": {"type": "integer", "minimum": 0},
        "directions": {"type": "array", "items": {"enum": [1, -1]}},
        "minDeckSize": {"type": "integer", "minimum": 1},
        "maxCopies": {"type": ["integer", "null"], "minimum": 1}, "extraBasicLands": {"type": "boolean"},
        "mulligan": {"type": "object", "required": ["kind", "handSize", "freeMulligans"], "properties": {"kind": {"const": "london"}, "handSize": {"type": "integer", "minimum": 1}, "freeMulligans": {"type": "integer", "minimum": 0}}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }}
  }
}
